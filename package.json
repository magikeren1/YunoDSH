{
  "name": "yunodsh",
  "version": "0.1.0",
  "private": true,
  "description": "Development foundation for a DSH Discord bridge based on dc-bridge.",
  "type": "module",
  "engines": { "node": ">=26.0.0 <27" },
  "dependencies": { "@deepseek-ai/dsh": "0.2.2-rc.2" },
  "scripts": {
    "project:init": "node scripts/project.mjs init",
    "persona:apply": "node scripts/apply-persona.mjs",
    "persona:reload": "npm run persona:apply && node scripts/restart-dsh.mjs",
    "dsh:restart": "node scripts/restart-dsh.mjs",
    "shutdown": "node scripts/shutdown.mjs",
    "startup": "node scripts/startup.mjs",
    "bot:status": "node scripts/bot-status.mjs",
    "dsh:start": "node scripts/project.mjs dsh",
    "dsh:smoke": "node scripts/project.mjs smoke",
    "discord:start": "node scripts/project.mjs discord",
    "test:discord": "npm --prefix apps/discord run test:discord",
    "check": "node --check scripts/doctor.mjs && node scripts/doctor.mjs",
    "doctor": "node scripts/doctor.mjs",
    "doctor:deployment": "node scripts/doctor.mjs --deployment"
  }
}
